NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://healthapp:healthapp_dev_password@localhost:5432/healthapp?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=15
OCR_PROVIDER=disabled
PADDLEOCR_PYTHON=python3
PADDLEOCR_MAX_PAGES=20
PADDLEOCR_MAX_PIXELS=25000000
PADDLEOCR_TIMEOUT_MS=120000
PADDLEOCR_STARTUP_TIMEOUT_MS=180000
PADDLEOCR_CPU_THREADS=2
PADDLEOCR_USE_GPU=false
# Optional: set to the model cache folder; PaddleOCR downloads models on first start.
# PADDLE_OCR_BASE_DIR=/var/cache/paddleocr
EXTRACTION_RETENTION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
AI_PROVIDER=disabled
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
ANONYMOUS_DATA_PIPELINE_ENABLED=false
