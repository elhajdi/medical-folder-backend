{
  "info": {
    "_postman_id": "5f99a253-6353-4b7f-9ec3-7632a02fa70e",
    "name": "Morocco Patient Health Record API",
    "description": "Postman requests for the local NestJS API. Uses synthetic test values only. Do not use real patient data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "prescriptionId",
      "value": ""
    },
    {
      "key": "rejectionPrescriptionId",
      "value": ""
    },
    {
      "key": "otherAccessToken",
      "value": ""
    },
    {
      "key": "secondDocumentId",
      "value": ""
    },
    {
      "key": "medicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get health status",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register synthetic test user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo-user@example.test\",\n  \"password\": \"Synthetic-Test-Password-123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Log in synthetic test user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo-user@example.test\",\n  \"password\": \"Synthetic-Test-Password-123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/profile"
          }
        },
        {
          "name": "Update my profile (synthetic values)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Synthetic\",\n  \"lastName\": \"Example\",\n  \"preferredLanguage\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/profile"
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List my documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents?type=LAB_RESULT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "documents"],
              "query": [
                {
                  "key": "type",
                  "value": "LAB_RESULT",
                  "description": "Optional document type filter."
                }
              ]
            }
          }
        },
        {
          "name": "Upload synthetic test document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('documentId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "type",
                  "value": "OTHER",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Synthetic API test file",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Synthetic test fixture; not a patient document.",
                  "type": "text"
                },
                {
                  "key": "documentDate",
                  "value": "2025-01-01",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/documents/upload",
            "description": "Select a synthetic PDF, JPEG, or PNG file in Postman. Do not upload real medical documents."
          }
        },
        {
          "name": "Upload synthetic prescription for review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) {",
                  "    pm.collectionVariables.set('prescriptionId', body.id);",
                  "    pm.collectionVariables.set('documentId', body.id);",
                  "  }",
                  "  if (body.processing) pm.test('Processing response is review-only', () => pm.expect(body.processing.status).to.be.oneOf(['needs_review', 'failed', 'processing', 'queued']));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "type",
                  "value": "PRESCRIPTION",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Synthetic prescription for review",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Synthetic test fixture only; not a patient document.",
                  "type": "text"
                },
                {
                  "key": "documentDate",
                  "value": "2026-01-15",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/documents/upload",
            "description": "Select a synthetic PDF, JPEG, or PNG only. This stores the returned prescription ID for the status, retry, and extraction requests. With OCR_PROVIDER=disabled, processing safely reports OCR_UNAVAILABLE. Never upload a real prescription."
          }
        },
        {
          "name": "Get prescription processing status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{prescriptionId}}/processing-status",
            "description": "Returns safe status/provider/timestamp/error metadata for your own prescription. Candidate data is not returned here."
          }
        },
        {
          "name": "Retry prescription processing",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents/{{prescriptionId}}/process",
            "description": "Retries processing for your own prescription. OCR remains disabled unless an approved provider is configured; this never confirms instructions or creates medication plans or reminders."
          }
        },
        {
          "name": "Get prescription extraction candidates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/extraction",
            "description": "Returns only your unconfirmed review candidates, with unknown/ambiguous fields preserved as null. Candidates expire according to the configured retention window."
          }
        },
        {
          "name": "Review prescription candidate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prescriptionDate\": { \"value\": \"2026-01-15\", \"confidence\": null, \"source\": null },\n  \"clinician\": { \"value\": \"Synthetic Clinician\", \"confidence\": null, \"source\": null },\n  \"facility\": { \"value\": \"Synthetic Clinic\", \"confidence\": null, \"source\": null },\n  \"medications\": [\n    {\n      \"name\": { \"value\": \"Synthetic medicine\", \"confidence\": null, \"source\": null },\n      \"strength\": { \"value\": \"10 mg\", \"confidence\": null, \"source\": null },\n      \"form\": { \"value\": \"tablet\", \"confidence\": null, \"source\": null },\n      \"dose\": { \"value\": \"1 tablet\", \"confidence\": null, \"source\": null },\n      \"route\": { \"value\": \"oral\", \"confidence\": null, \"source\": null },\n      \"frequency\": { \"value\": \"once daily\", \"confidence\": null, \"source\": null },\n      \"duration\": { \"value\": \"5 days\", \"confidence\": null, \"source\": null },\n      \"quantity\": { \"value\": \"5\", \"confidence\": null, \"source\": null },\n      \"instructions\": { \"value\": null, \"confidence\": null, \"source\": null }\n    }\n  ],\n  \"warnings\": [],\n  \"reviewRequired\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/extraction",
            "description": "Scenario: patient corrects a needs_review candidate. Requires OCR/provider processing to have produced a candidate for this synthetic prescription. Edits remain provisional and do not create medication records."
          }
        },
        {
          "name": "Confirm incomplete candidate (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Incomplete candidate cannot be confirmed', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/confirm",
            "description": "Negative validation scenario: a needs_review candidate missing its required prescription date and medication details must be rejected. Requires an existing unconfirmed candidate."
          }
        },
        {
          "name": "Confirm reviewed prescription candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Confirmation is successful', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('confirmed');",
                  "  pm.expect(body.confirmedAt).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prescriptionDate\": { \"value\": \"2026-01-15\", \"confidence\": null, \"source\": null },\n  \"medications\": [\n    {\n      \"name\": { \"value\": \"Synthetic medicine\", \"confidence\": null, \"source\": null },\n      \"dose\": { \"value\": \"1 tablet\", \"confidence\": null, \"source\": null },\n      \"frequency\": { \"value\": \"once daily\", \"confidence\": null, \"source\": null },\n      \"instructions\": { \"value\": \"once daily\", \"confidence\": null, \"source\": null }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/confirm",
            "description": "Scenario: explicitly confirm a reviewed candidate with required synthetic date, medication name, dose, and frequency. Only patient confirmation is recorded; it is not clinician verification or medical advice. Do not run after rejecting this same candidate."
          }
        },
        {
          "name": "Reject prescription candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Synthetic test rejection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/prescriptions/{{rejectionPrescriptionId}}/reject",
            "description": "Alternative lifecycle scenario: reject a separate unconfirmed candidate. Set rejectionPrescriptionId to a different synthetic prescription with status needs_review; a rejected candidate cannot later be confirmed."
          }
        },
        {
          "name": "Read extraction as another patient (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Another patient cannot read this extraction', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/extraction",
            "description": "Negative authorization scenario: set otherAccessToken to a separately registered synthetic user's token. The owner-scoped endpoint must return 404 for another patient's prescription."
          }
        },
        {
          "name": "Link two of my documents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromDocumentId\": \"{{documentId}}\",\n  \"toDocumentId\": \"{{secondDocumentId}}\",\n  \"relationship\": \"synthetic-test-link\",\n  \"note\": \"Synthetic test data only.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/documents/links"
          }
        },
        {
          "name": "List links for a document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/links"
          }
        },
        {
          "name": "Download my document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/download"
          }
        },
        {
          "name": "Delete my document",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          }
        }
      ]
    },
    {
      "name": "Medications",
      "item": [
        {
          "name": "List my medication plans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/medications"
          }
        },
        {
          "name": "Create synthetic medication plan entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('medicationId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Synthetic demo entry\",\n  \"dosage\": \"Synthetic test value; not for use\",\n  \"instructions\": \"Synthetic API testing only.\",\n  \"startDate\": \"2025-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/medications"
          }
        },
        {
          "name": "Update my medication plan",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instructions\": \"Updated synthetic test value.\",\n  \"status\": \"PAUSED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/medications/{{medicationId}}"
          }
        },
        {
          "name": "Delete my medication plan",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/medications/{{medicationId}}"
          }
        }
      ]
    },
    {
      "name": "Cloud storage and privacy",
      "item": [
        {
          "name": "Get integration capability status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/cloud-connections/status",
            "description": "Authenticated global capability status only; this does not report a user's connection. Google Drive OAuth and anonymous-data writes are disabled. Synthetic data only."
          }
        }
      ]
    },
    {
      "name": "AI assistance",
      "item": [
        {
          "name": "Request disabled medical-history summary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentIds\": [\"{{documentId}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/ai/medical-history-summary",
            "description": "This endpoint is a disabled stub. It does not generate clinical conclusions or call an AI provider."
          }
        }
      ]
    }
  ]
}
