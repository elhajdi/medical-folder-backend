generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  role                    String                   @default("PATIENT")
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  profile                 PatientProfile?
  documents               MedicalDocument[]
  medications             Medication[]
  auditEvents             AuditEvent[]
  prescriptionExtractions PrescriptionExtraction[]
}

model PatientProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  firstName             String?
  lastName              String?
  dateOfBirth           DateTime?
  phone                 String?
  preferredLanguage     String    @default("fr")
  timezone              String    @default("Africa/Casablanca")
  emergencyContactName  String?
  emergencyContactPhone String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model MedicalDocument {
  id                     String                  @id @default(cuid())
  ownerId                String
  type                   String
  title                  String
  description            String?
  documentDate           DateTime?
  originalFilename       String
  mimeType               String
  sizeBytes              Int
  storageKey             String                  @unique
  sha256                 String
  status                 String                  @default("UPLOADED")
  extractedText          String?
  aiSummary              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  owner                  User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  linksFrom              DocumentLink[]          @relation("FromDocument")
  linksTo                DocumentLink[]          @relation("ToDocument")
  prescriptionExtraction PrescriptionExtraction?

  @@index([ownerId, documentDate])
  @@index([ownerId, type])
  @@index([ownerId, type, sha256])
}

model PrescriptionExtraction {
  id              String          @id @default(cuid())
  documentId      String          @unique
  ownerId         String
  status          String          @default("queued")
  candidate       Json?
  provider        String
  providerVersion String?
  errorCategory   String?
  confirmation    Json?
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  rejectedReason  String?
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  updatedAt       DateTime        @updatedAt
  document        MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([ownerId, documentId])
}

model DocumentLink {
  id             String          @id @default(cuid())
  ownerId        String
  fromDocumentId String
  toDocumentId   String
  relationship   String
  note           String?
  createdAt      DateTime        @default(now())
  fromDocument   MedicalDocument @relation("FromDocument", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument     MedicalDocument @relation("ToDocument", fields: [toDocumentId], references: [id], onDelete: Cascade)

  @@unique([fromDocumentId, toDocumentId, relationship])
  @@index([ownerId])
}

model Medication {
  id                   String               @id @default(cuid())
  ownerId              String
  name                 String
  dosage               String
  instructions         String?
  startDate            DateTime
  endDate              DateTime?
  status               String               @default("ACTIVE")
  prescribingClinician String?
  sourceDocumentId     String?
  confirmedByPatientAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reminders            MedicationReminder[]

  @@index([ownerId, status])
}

model MedicationReminder {
  id           String     @id @default(cuid())
  medicationId String
  localTime    String
  daysOfWeek   Json
  channel      String     @default("PUSH")
  enabled      Boolean    @default(true)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([medicationId, enabled])
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}
